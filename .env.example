# ─────────────────────────────────────────────────────────────────────────
# NovaMart Multi-Agent Support — environment template
# Copy to .env and fill in your own values. .env is gitignored.
# Most resource names resolve automatically from CloudFormation exports
# once you've deployed your own infrastructure (see docs/deployment.md);
# only values that cannot be auto-discovered go here.
# ─────────────────────────────────────────────────────────────────────────

AWS_REGION=us-east-1
PROJECT_NAME=novamart-agentcore

# ── Bedrock Knowledge Base IDs (created manually in the console) ──────────
RETURNS_KB_ID=
SHIPPING_KB_ID=
WARRANTY_KB_ID=

# ── AgentCore Runtime (printed by `python main.py deploy`) ────────────────
AGENTCORE_RUNTIME_ARN=

# ── Guardrail (printed by the deploy command) ──────────────────────────────
GUARDRAIL_ID=
GUARDRAIL_VERSION=

# ── Observability (optional local overrides) ───────────────────────────────
# AGENT_TRACING_ENABLED=true
# AGENT_TRACE_SAMPLING_RATE=1.0
# AGENT_LOG_LEVEL=INFO
